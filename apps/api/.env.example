# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/quibly

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# RevenueCat
REVENUECAT_WEBHOOK_AUTH_KEY=your_revenuecat_webhook_auth_key

# Server
PORT=3000

# Comma-separated allowlist of origins allowed to call the API from a
# browser (web app, admin panel, ...). Leave empty to block all
# cross-origin browser access — the mobile app doesn't need this, it
# doesn't send an Origin header.
CORS_ORIGINS=https://tryquibly.com,https://app.tryquibly.com
