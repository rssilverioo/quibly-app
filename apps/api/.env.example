# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/quibly

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# RevenueCat
REVENUECAT_WEBHOOK_AUTH_KEY=your_revenuecat_webhook_auth_key

# Server
PORT=3000

# Comma-separated allowlist of origins allowed to call the API from a
# browser (web app, admin panel, ...). Leave empty to block all
# cross-origin browser access — the mobile app doesn't need this, it
# doesn't send an Origin header.
CORS_ORIGINS=https://quibly.com.br,https://app.quibly.com.br

# Sentry (error reporting). Leave empty/unset to keep Sentry fully
# disabled — no init, no network calls, no console noise. As of this
# writing there is no DSN yet (pending from the CEO); the app is designed
# to run correctly with this unset and to start reporting the moment a
# real DSN is filled in, with no code change.
SENTRY_DSN=

# Storage (Tigris, S3-compatível). Desde 21/09/2026 o domínio público é
# cdn.quibly.com.br (custom domain do bucket público). Sem S3_PUBLIC_BASE_URL a
# URL é montada a partir de S3_ENDPOINT + bucket. Sem aspas, sem barra no fim.
S3_ENDPOINT=https://t3.storage.dev
S3_BUCKET_PUBLIC=your-public-bucket
S3_BUCKET_PRIVATE=your-private-bucket
S3_PUBLIC_BASE_URL=https://cdn.quibly.com.br
