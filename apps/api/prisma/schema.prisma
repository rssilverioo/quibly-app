generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───

enum Plan {
  FREE
  PRO

  @@map("plan")
}

enum TimerMode {
  pomodoro
  deep_focus
  custom
  audio
  /// Count-up timer with no target duration — start, run, stop. The default
  /// mode in YPT and the most used one there: a fixed pomodoro is too rigid
  /// for someone sitting down for six hours. Sessions in this mode never
  /// earn pomodoro cycles.
  stopwatch

  @@map("timer_mode")
}

enum SessionStatus {
  active
  paused
  completed
  abandoned

  @@map("session_status")
}

/// How a Lesson was captured.
enum LessonSource {
  audio
  document
  photo

  @@map("lesson_source")
}

enum LessonStatus {
  /// Transcribing / extracting / structuring
  processing
  ready
  failed

  @@map("lesson_status")
}

enum ProofCheckStatus {
  pending
  passed
  failed
  missed

  @@map("proof_check_status")
}

enum LeaguePrivacy {
  public
  private

  @@map("league_privacy")
}

enum LeagueMode {
  easy
  competitive
  hardcore

  @@map("league_mode")
}

enum LeagueStatus {
  upcoming
  active
  completed

  @@map("league_status")
}

enum MemberRole {
  owner
  admin
  member

  @@map("member_role")
}

enum ChatMessageType {
  text
  system

  @@map("chat_message_type")
}

// ─── MODELS ───

model Profile {
  id                     String    @id // Firebase UID
  email                  String    @unique
  username               String
  handle                 String    @unique
  avatarUrl              String?   @map("avatar_url")
  bio                    String?
  totalXp                Int       @default(0) @map("total_xp")
  level                  Int       @default(1)
  lockInScore            Int       @default(0) @map("lock_in_score")
  verifiedHours          Decimal   @default(0) @map("verified_hours") @db.Decimal(10, 2)
  currentStreak          Int       @default(0) @map("current_streak")
  longestStreak          Int       @default(0) @map("longest_streak")
  totalStudyMinutes      Int       @default(0) @map("total_study_minutes")
  lastStudyDate          DateTime? @map("last_study_date") @db.Date
  plan                   Plan      @default(FREE)
  subscriptionStatus     String?   @map("subscription_status")
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamptz()
  subscriptionPlatform   String?   @map("subscription_platform")  // 'apple' | 'google'
  onboardingCompleted    Boolean   @default(false) @map("onboarding_completed")
  educationLevel         String?   @map("education_level")   // high_school | college | graduate | professional
  studyGoal              String?   @map("study_goal")        // exam_prep | school | certification | fun
  dailyGoalMinutes       Int       @default(15) @map("daily_goal_minutes")

  /// ISO 3166-1 alpha-2, resolvido no onboarding por locale + IP.
  countryCode            String?   @map("country_code") @db.Char(2)
  /// A prova que o usuário está estudando. Sugerida por geo, sempre trocável.
  examTrackId            String?   @map("exam_track_id") @db.Uuid
  /// IANA, ex: 'America/Sao_Paulo'. A Fase 2 precisa disto para horário de
  /// silêncio das notificações; a Fase 6, para fechar o dia no fuso certo.
  timezone               String?
  /// Data da prova alvo, quando existe. É o `dias até a prova` da Fase 6.
  examDate               DateTime? @map("exam_date") @db.Date

  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  subjects          Subject[]
  dailyPlans        DailyPlan[]
  studySessions     StudySession[]
  proofChecks       ProofCheck[]
  ownedLeagues      League[]         @relation("LeagueOwner")
  leagueMemberships LeagueMember[]
  feedPosts         FeedPost[]
  feedReactions     FeedReaction[]
  feedComments      FeedComment[]
  chatMessages      ChatMessage[]
  chatReactions     ChatReaction[]
  userAchievements  UserAchievement[]
  pushTokens        PushToken[]
  documents         Document[]
  lessons           Lesson[]
  flashcardSets     FlashcardSet[]
  quizzes           Quiz[]
  dailyUsage        DailyUsage[]
  audioStudySessions AudioStudySession[]
  sessionAnomalies  SessionAnomaly[]
  country           Country?         @relation(fields: [countryCode], references: [code], onDelete: SetNull)
  examTrack         ExamTrack?       @relation(fields: [examTrackId], references: [id], onDelete: SetNull)
  topicMastery      TopicMastery[]

  @@index([level(sort: Desc)])
  @@index([totalXp(sort: Desc)])
  @@map("profiles")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  name      String
  color     String   @default("#7C5CFC")
  icon      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user     Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions StudySession[]

  @@unique([userId, name])
  @@index([userId])
  @@map("subjects")
}

model StudySession {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @map("user_id")
  subjectId               String        @map("subject_id") @db.Uuid
  leagueId                String?       @map("league_id") @db.Uuid
  timerMode               TimerMode     @default(pomodoro) @map("timer_mode")
  workDuration            Int           @default(25) @map("work_duration")
  breakDuration           Int           @default(5) @map("break_duration")
  proofMode               Boolean       @default(false) @map("proof_mode")
  status                  SessionStatus @default(active)
  isVerified              Boolean       @default(false) @map("is_verified")
  startedAt               DateTime      @default(now()) @map("started_at") @db.Timestamptz()
  endedAt                 DateTime?     @map("ended_at") @db.Timestamptz()
  totalDurationMinutes    Decimal       @default(0) @map("total_duration_minutes") @db.Decimal(10, 2)
  pomodoroCyclesCompleted Int           @default(0) @map("pomodoro_cycles_completed")
  pointsEarned            Int           @default(0) @map("points_earned")
  xpEarned                Int           @default(0) @map("xp_earned")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  /// Last `POST /sessions/:id/heartbeat`. The client is expected to beat every
  /// 30s; a session whose last beat is older than the grace window is swept to
  /// `abandoned` and credited only up to this instant. NULL means the session
  /// has not beaten once yet — the sweeper falls back to `startedAt`.
  lastHeartbeatAt         DateTime?     @map("last_heartbeat_at") @db.Timestamptz()
  /// Wall-clock instant the session became `paused`. NULL whenever the session
  /// is not currently paused. The closed intervals live in `SessionPause`;
  /// this is only the open one.
  pausedAt                DateTime?     @map("paused_at") @db.Timestamptz()
  /// How the session reached a terminal state: 'user' (explicit end),
  /// 'abandoned_no_heartbeat' (swept), 'user_abandon' (explicit discard).
  /// Kept as a plain string so adding a reason is not a migration.
  endReason               String?       @map("end_reason")
  /// Server-computed seconds the session actually ran, before the daily cap is
  /// applied. `totalDurationMinutes` is what got credited; this is what was
  /// measured. When they disagree, the cap clipped the session.
  measuredSeconds         Int?          @map("measured_seconds")

  user        Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  league      League?      @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  proofChecks ProofCheck[]
  feedPosts   FeedPost[]
  audioSession AudioStudySession?
  pauses      SessionPause[]
  anomalies   SessionAnomaly[]
  topics      SessionTopic[]

  @@index([userId])
  @@index([userId, startedAt(sort: Desc)])
  @@index([leagueId])
  @@index([status])
  /// The sweeper's query: every live session whose heartbeat went stale.
  @@index([status, lastHeartbeatAt])
  @@map("study_sessions")
}

/// One pause interval of a study session. Kept as rows rather than a running
/// counter so the duration the server credits can be recomputed from scratch
/// at any point — including for a session swept mid-pause, where the interval
/// has to be clipped to the last heartbeat rather than to `now`.
model SessionPause {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  startedAt DateTime  @map("started_at") @db.Timestamptz()
  /// NULL while the pause is still open.
  endedAt   DateTime? @map("ended_at") @db.Timestamptz()

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("quibly_session_pauses")
}

/// Antifraud trail. Fase 1 deliberately does not ban, throttle or reject on
/// these — it records them so that a later phase can look at real data instead
/// of guessing what abuse looks like. See docs/API-SESSIONS.md §5.
model SessionAnomaly {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  sessionId String?  @map("session_id") @db.Uuid
  /// 'overlap_rejected' | 'daily_cap_clipped' | 'implausible_duration' |
  /// 'heartbeat_gap' — see SessionAnomalyKind in sessions/session-timing.ts
  kind      String
  /// Whatever the check measured, so the row is readable without re-deriving
  /// it from the session. Shape varies by `kind`.
  detail    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user    Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  session StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@map("quibly_session_anomalies")
}

model ProofCheck {
  id          String           @id @default(uuid()) @db.Uuid
  sessionId   String           @map("session_id") @db.Uuid
  userId      String           @map("user_id")
  triggeredAt DateTime         @default(now()) @map("triggered_at") @db.Timestamptz()
  respondedAt DateTime?        @map("responded_at") @db.Timestamptz()
  photoUrl    String?          @map("photo_url")
  status      ProofCheckStatus @default(pending)
  deadlineAt  DateTime         @map("deadline_at") @db.Timestamptz()
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@map("proof_checks")
}

model League {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  ownerId     String        @map("owner_id")
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime      @map("end_date") @db.Date
  privacy     LeaguePrivacy @default(private)
  mode        LeagueMode    @default(competitive)
  participationMode String  @default("photo") @map("participation_mode")
  status      LeagueStatus  @default(upcoming)
  inviteCode  String        @unique @map("invite_code")
  maxMembers  Int           @default(50) @map("max_members")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  owner        Profile        @relation("LeagueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      LeagueMember[]
  sessions     StudySession[]
  feedPosts    FeedPost[]
  chatMessages ChatMessage[]

  @@index([status])
  @@index([ownerId])
  @@map("leagues")
}

model LeagueMember {
  id            String     @id @default(uuid()) @db.Uuid
  leagueId      String     @map("league_id") @db.Uuid
  userId        String     @map("user_id")
  role          MemberRole @default(member)
  displayName   String     @map("display_name") @db.VarChar(30)
  totalSp       Int        @default(0) @map("total_sp")
  weeklySp      Int        @default(0) @map("weekly_sp")
  monthlySp     Int        @default(0) @map("monthly_sp")
  verifiedHours Decimal    @default(0) @map("verified_hours") @db.Decimal(10, 2)
  joinedAt      DateTime   @default(now()) @map("joined_at") @db.Timestamptz()

  league League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([leagueId])
  @@index([userId])
  @@index([leagueId, totalSp(sort: Desc)])
  @@map("league_members")
}

model FeedPost {
  id             String   @id @default(uuid()) @db.Uuid
  leagueId       String   @map("league_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.Uuid
  userId         String   @map("user_id")
  showProofPhoto Boolean  @default(false) @map("show_proof_photo")
  caption        String?  @db.VarChar(280)
  photoUrl       String?  @map("photo_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  league    League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  session   StudySession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions FeedReaction[]
  comments  FeedComment[]

  @@index([leagueId, createdAt(sort: Desc)])
  @@map("feed_posts")
}

model FeedReaction {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@map("feed_reactions")
}

model FeedComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("feed_comments")
}

model ChatMessage {
  id          String          @id @default(uuid()) @db.Uuid
  leagueId    String          @map("league_id") @db.Uuid
  userId      String?         @map("user_id")
  content     String
  messageType ChatMessageType @default(text) @map("message_type")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  /// Quando o autor apagou. A linha fica: some da conversa, continua para
  /// moderação. Apagar de verdade levava a prova junto com a mensagem.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  /// Quando o conteúdo foi expurgado pelo prazo de retenção.
  ///
  /// O expurgo esvazia `content` e **preserva autor, data e hora**: é o que
  /// sustenta uma investigação de abuso sem guardar texto de usuário para
  /// sempre, que é justamente o que a LGPD manda justificar.
  purgedAt DateTime? @map("purged_at") @db.Timestamptz()

  league    League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user      Profile?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  reactions ChatReaction[]

  @@index([leagueId, createdAt(sort: Desc)])
  /// O expurgo varre por "apagadas há mais de N dias, ainda com conteúdo".
  @@index([deletedAt])
  @@map("chat_messages")
}

model ChatReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_reactions")
}

enum AchievementCategory {
  streak
  volume
  sessions
  proof
  social
  level

  @@map("achievement_category")
}

model Achievement {
  id          String              @id
  name        String
  description String
  icon        String
  category    AchievementCategory
  threshold   Int
  sortOrder   Int                 @default(0) @map("sort_order")

  userAchievements UserAchievement[]

  @@index([category])
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at") @db.Timestamptz()

  user        Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ─── Documents & AI Content ───

model Document {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id")
  title         String
  subject       String?
  s3Key         String   @map("s3_key")
  originalName  String   @map("original_name")
  mimeType      String   @map("mime_type")
  sizeBytes     Int      @map("size_bytes")
  extractedText String?  @map("extracted_text") @db.Text
  pageCount     Int?     @map("page_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user          Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  flashcardSets FlashcardSet[]
  quizzes       Quiz[]

  @@index([userId])
  @@map("documents")
}

/// A captured class: recording, PDF or photo of a notebook, turned into a
/// structured note. This is the object the app is built around — flashcards
/// and quizzes are derived from it, not the other way round.
model Lesson {
  id       String       @id @default(uuid()) @db.Uuid
  userId   String       @map("user_id")
  title    String
  subject  String?
  source   LessonSource
  status   LessonStatus @default(processing)
  language String       @default("pt-BR")

  /// Transcript (audio) or extracted text (document/photo). The source of
  /// truth everything else is generated from.
  rawText String? @map("raw_text") @db.Text

  /// Structured note, derived from rawText.
  summary       String? @db.Text
  keyPoints     Json    @default("[]") @map("key_points")
  openQuestions Json    @default("[]") @map("open_questions")

  /// Audio captures only.
  audioKey    String? @map("audio_key")
  durationSec Int?    @map("duration_sec")

  /// Set when the capture came through the documents pipeline.
  documentId   String? @map("document_id") @db.Uuid
  errorMessage String? @map("error_message") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  processedAt DateTime? @map("processed_at") @db.Timestamptz()

  user          Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  flashcardSets FlashcardSet[]
  quizzes       Quiz[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([documentId])
  // Not "lessons": that name belongs to another product's table in the shared
  // production database, and it has dependents.
  @@map("captured_lessons")
}

model FlashcardSet {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id")
  documentId String?  @map("document_id") @db.Uuid
  lessonId   String?  @map("lesson_id") @db.Uuid
  title      String
  language   String   @default("en")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user       Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  lesson     Lesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@index([userId])
  @@index([documentId])
  @@index([lessonId])
  @@map("flashcard_sets")
}

model Flashcard {
  id         String  @id @default(uuid()) @db.Uuid
  setId      String  @map("set_id") @db.Uuid
  front      String  @db.Text
  back       String  @db.Text
  explain    String? @db.Text
  imageUrl   String? @map("image_url")
  sortOrder  Int     @default(0) @map("sort_order")

  set FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@map("flashcards")
}

model Quiz {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id")
  documentId String?  @map("document_id") @db.Uuid
  lessonId   String?  @map("lesson_id") @db.Uuid
  title      String
  language   String   @default("en")
  score      Int?
  totalQ     Int      @default(0) @map("total_q")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user      Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  document  Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  lesson    Lesson?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([userId])
  @@index([documentId])
  @@index([lessonId])
  @@map("quizzes")
}

model Question {
  id           String @id @default(uuid()) @db.Uuid
  quizId       String @map("quiz_id") @db.Uuid
  question     String @db.Text
  options      Json   // string[4]
  correctIndex Int    @map("correct_index")
  imageUrl     String? @map("image_url")
  sortOrder    Int    @default(0) @map("sort_order")
  /// Liga a questão ao currículo. Nullable porque todo o conteúdo gerado
  /// antes da Fase 1 não tem tópico, e não há de onde inferir.
  topicId      String? @map("topic_id") @db.Uuid

  quiz  Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([quizId])
  @@index([topicId])
  @@map("questions")
}

model DailyUsage {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id")
  date           DateTime @db.Date
  flashcardSets  Int      @default(0) @map("flashcard_sets")
  quizzes        Int      @default(0)
  audioSessions  Int      @default(0) @map("audio_sessions")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_usage")
}

model AudioClip {
  id          String   @id @default(uuid()) @db.Uuid
  textHash    String   @unique @map("text_hash")
  text        String   @db.Text
  voice       String   @default("alloy")
  language    String
  url         String   @db.Text
  durationSec Float    @map("duration_sec")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([language])
  @@map("audio_clips")
}

model AudioStudySession {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id")
  studySessionId         String?   @unique @map("study_session_id") @db.Uuid
  flashcardSetId         String?   @map("flashcard_set_id") @db.Uuid
  language               String
  plannedDurationMinutes Int       @map("planned_duration_minutes")
  totalDurationSec       Float     @default(0) @map("total_duration_sec")
  status                 String    @default("generating")
  clips                  Json      @default("[]")
  errorMessage           String?   @map("error_message") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  readyAt                DateTime? @map("ready_at") @db.Timestamptz()

  user         Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySession StudySession? @relation(fields: [studySessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("audio_study_sessions")
}

model DailyPlan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  date      DateTime @db.Date
  tasks     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_plans")
}

// ─── Entitlements & AI cost control (Fase 0, Bloco 3/4) ───
//
// New tables only, all `@@map`-prefixed with "quibly_" so they can't collide
// with the neighboring product's tables in the shared production Postgres —
// same reason `Lesson` maps to "captured_lessons" instead of "lessons".
// None of these carry a Prisma `@relation` to `Profile`: `userId` is a plain
// indexed string. That's deliberate — it avoids touching the `Profile` model
// (contended by every squad right now) just to add a back-relation array
// field, at the cost of no DB-level referential integrity for these rows.

/// Per-plan limits, resolved by `EntitlementService` instead of a hardcoded
/// constant. A missing (plan, key) row — including "table not seeded yet" —
/// resolves to Infinity in the service layer, which is the Fase 0 launch
/// state: everything unlocked. Turning a limit on in Fase 7 is an UPDATE
/// here, not a deploy.
model Entitlement {
  id         String   @id @default(uuid()) @db.Uuid
  plan       Plan
  /// 'flashcard_sets' | 'quizzes' | 'audio_sessions' | 'ai_daily_tokens' — see
  /// EntitlementKey in apps/api/src/entitlements/entitlements.constants.ts
  key        String
  /// NULL = unlimited. Present so "no row" and "explicitly unlimited" are
  /// both expressible without magic numbers.
  limitValue Int?     @map("limit_value")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([plan, key])
  @@map("quibly_entitlements")
}

/// One row per AI call, for cost visibility and the per-user daily token
/// budget in `AiRouterService`. `inputTokens`/`outputTokens` hold real LLM
/// token counts for chat-completion tasks; for audio tasks (transcription,
/// tts) they hold a documented proxy unit (seconds, characters) instead of
/// tokens — see MODEL_PRICING in ai-router.constants.ts for which is which.
model AiUsageLedger {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id")
  /// Calendar day the call was billed against (server local midnight),
  /// mirrors the DailyUsage pattern — makes "cost today" a plain equality.
  date             DateTime @db.Date
  /// 'flashcards' | 'quiz' | 'lesson_structuring' | 'lesson_qa' | 'ocr' |
  /// 'transcription' | 'audio_script' | 'tts' | 'explain'
  task             String
  provider         String
  model            String
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  estimatedCostUsd Decimal  @default(0) @map("estimated_cost_usd") @db.Decimal(10, 6)
  /// True when this call was served from AiContentCache / AudioClip and cost
  /// nothing — kept in the ledger anyway so cache hit-rate is visible.
  cacheHit         Boolean  @default(false) @map("cache_hit")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, date])
  @@index([date])
  @@map("quibly_ai_usage_ledger")
}

/// Generalizes the `AudioClip.textHash` pattern to deterministic content
/// generation (flashcards/quiz from the same document+language). Keyed by a
/// hash of (task, language, source content) so a re-request never re-pays
/// for the same LLM call.
model AiContentCache {
  id          String   @id @default(uuid()) @db.Uuid
  contentHash String   @unique @map("content_hash")
  task        String
  language    String
  result      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([task])
  @@map("quibly_ai_content_cache")
}

// ─── CURRÍCULO (Fase 1) ───────────────────────────────────────────────────
//
// A decisão arquitetural central da reformulação (ARCHITECTURE.md §2): o
// currículo é o eixo, e "Brasil primeiro, depois o mundo" vira um seed de
// dados em vez de um refactor.
//
//   Country → ExamTrack → Discipline → Topic
//
// O `Topic` é a unidade atômica do sistema inteiro: liga onboarding, salas,
// sessões, questões, medição de domínio e — na Fase 6 — o gerador de plano.

model Country {
  /// ISO 3166-1 alpha-2. Chave natural de propósito: o código do país já é
  /// estável e universal, e usar UUID aqui só criaria uma indireção a mais
  /// em cima de um identificador que o mundo inteiro já concorda.
  code      String   @id @db.Char(2)
  nameEn    String   @map("name_en")
  namePt    String   @map("name_pt")
  /// Locale padrão para sugerir conteúdo, ex: 'pt-BR'.
  locale    String
  /// Desligar um país sem apagar dados de quem já o escolheu.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tracks   ExamTrack[]
  profiles Profile[]

  @@map("quibly_countries")
}

model ExamTrack {
  id          String  @id @default(uuid()) @db.Uuid
  countryCode String  @map("country_code") @db.Char(2)
  /// Estável e legível: 'enem', 'oab', 'sat'. É o que os seeds usam como
  /// chave de upsert, então renomear um slug quebra a idempotência.
  slug        String
  name        String
  description String?
  /// Ordem de exibição na sugestão do onboarding.
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  country     Country      @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  disciplines Discipline[]
  profiles    Profile[]

  @@unique([countryCode, slug])
  @@index([countryCode])
  @@map("quibly_exam_tracks")
}

model Discipline {
  id          String  @id @default(uuid()) @db.Uuid
  trackId     String  @map("track_id") @db.Uuid
  slug        String
  name        String
  /// Cor sugerida ao virar `Subject` do usuário no onboarding.
  color       String  @default("#7C5CFC")
  icon        String?
  sortOrder   Int     @default(0) @map("sort_order")

  track  ExamTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@unique([trackId, slug])
  @@index([trackId])
  @@map("quibly_disciplines")
}

model Topic {
  id           String @id @default(uuid()) @db.Uuid
  disciplineId String @map("discipline_id") @db.Uuid
  slug         String
  name         String

  /// Quanto o tópico vale na prova, 0–100. Junto com `frequency`, é uma das
  /// duas entradas do gerador de plano da Fase 6:
  ///   peso × (1 − domínio) × urgência = prioridade
  /// Peso errado aqui envenena o plano de estudo de todo mundo, por isso
  /// `weightSource` é obrigatório na prática — ver seeds.
  weight       Int    @default(50)

  /// Em quantas das últimas 10 provas o tópico apareceu, 0–10. Peso diz
  /// quanto vale; frequência diz quão provável é cair. São coisas
  /// diferentes: um tópico pode valer muito e cair pouco.
  frequency    Int    @default(5)

  /// De onde saíram `weight` e `frequency`. Sem isto os números viram
  /// folclore em seis meses e ninguém sabe se dá para confiar.
  weightSource String? @map("weight_source")

  sortOrder    Int    @default(0) @map("sort_order")

  discipline Discipline      @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  sessions   SessionTopic[]
  mastery    TopicMastery[]
  questions  Question[]

  @@unique([disciplineId, slug])
  @@index([disciplineId])
  @@map("quibly_topics")
}

/// O que o usuário marcou ter estudado numa sessão.
///
/// Esta tabela é a razão de o tagging começar na Fase 1 e não na Fase 6: sem
/// histórico, o gerador de plano nasce cego e precisa de um backfill que não
/// existe (ARCHITECTURE.md §2, "regra inegociável").
model SessionTopic {
  sessionId String   @map("session_id") @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic   Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([sessionId, topicId])
  @@index([topicId])
  @@map("quibly_session_topics")
}

/// Domínio do usuário por tópico.
///
/// **Criada vazia de propósito.** Nada escreve aqui na Fase 1 — a Fase 4
/// (quiz alimentando mastery) começa a preencher. Existe agora porque criar
/// depois custaria um backfill de dados que ninguém guardou.
model TopicMastery {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id")
  topicId    String    @map("topic_id") @db.Uuid

  attempts   Int       @default(0)
  correct    Int       @default(0)
  /// Fator de facilidade no estilo SM-2/FSRS. 2.5 é o ponto de partida
  /// clássico; sobe com acerto, desce com erro.
  easeFactor Decimal   @default(2.5) @map("ease_factor") @db.Decimal(4, 2)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz()
  /// Quando este tópico deve voltar. A Fase 4 preenche; a Fase 6 lê.
  nextDueAt  DateTime? @map("next_due_at") @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, nextDueAt])
  @@map("quibly_topic_mastery")
}
