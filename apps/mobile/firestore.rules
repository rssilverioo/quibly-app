rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isLeagueMember(leagueId) {
      return isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.members;
    }

    function isLeagueOwner(leagueId) {
      return isAuthenticated()
        && request.auth.uid == get(/databases/$(database)/documents/leagues/$(leagueId)).data.owner_id;
    }

    // ─── Users ───

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ─── Subjects ───

    match /subjects/{subjectId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // ─── Leagues ───

    match /leagues/{leagueId} {
      // Any authenticated user can read public leagues; members can read private ones
      allow read: if isAuthenticated();
      // Any authenticated user can create a league
      allow create: if isAuthenticated()
        && request.resource.data.owner_id == request.auth.uid;
      // Only league owner or members can update (for join/leave operations)
      allow update: if isAuthenticated()
        && (isLeagueOwner(leagueId) || isLeagueMember(leagueId) || request.auth.uid in request.resource.data.members);
      allow delete: if isLeagueOwner(leagueId);

      // ─── League Members ───

      match /members/{memberId} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow create: if isAuthenticated();
        allow update: if isAuthenticated()
          && (isLeagueOwner(leagueId) || resource.data.user_id == request.auth.uid);
        allow delete: if isAuthenticated()
          && (isLeagueOwner(leagueId) || resource.data.user_id == request.auth.uid);
      }

      // ─── League Feed ───

      match /feed/{postId} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow create: if isAuthenticated() && isLeagueMember(leagueId);
        allow update: if isAuthenticated() && isLeagueMember(leagueId);
        allow delete: if isLeagueOwner(leagueId);

        // ─── Feed Comments ───

        match /comments/{commentId} {
          allow read: if isAuthenticated() && isLeagueMember(leagueId);
          allow create: if isAuthenticated() && isLeagueMember(leagueId);
          allow delete: if isAuthenticated()
            && (resource.data.user_id == request.auth.uid || isLeagueOwner(leagueId));
        }
      }

      // ─── League Chat ───

      match /chat/{messageId} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow create: if isAuthenticated() && isLeagueMember(leagueId);
        allow delete: if false;
      }
    }

    // ─── Study Sessions ───

    match /sessions/{sessionId} {
      allow read: if isAuthenticated()
        && (resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }
  }
}
