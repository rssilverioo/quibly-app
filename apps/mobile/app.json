{
  "expo": {
    "name": "Quibly",
    "slug": "quibly",
    "version": "1.2.1",
    "scheme": "quibly",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#015FFD"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.quibly.app",
      "appleTeamId": "3HWKHD9KF8",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:tryquibly.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Quibly uses the camera for your study check-in photos and your profile picture.",
        "NSPhotoLibraryUsageDescription": "Quibly needs photo library access to pick your check-in photo, profile picture, and room cover.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.quibly.app"
        ],
        "com.apple.developer.family-controls": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1",
              "C56D.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#015FFD"
      },
      "package": "com.quibly.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tryquibly.com",
              "pathPrefix": "/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "newArchEnabled": true,
    "plugins": [
      "@react-native-firebase/app",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Quibly to take your study check-in photos and your profile picture."
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4C9AFF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.419383312629-hl004370ib4ea9ni56daf3vu1k3g5ns2"
        }
      ],
      "./plugins/withFirebaseModularHeaders",
      "@bacons/apple-targets",
      "./plugins/withResourceBundleSigning",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7106022757613059~2061824574",
          "iosAppId": "ca-app-pub-7106022757613059~7466871837",
          "userTrackingUsageDescription": "Usamos isto para mostrar anúncios mais relevantes para você. Assine o Pro para não ver anúncio nenhum."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Usamos isto para mostrar anúncios mais relevantes para você. Assine o Pro para não ver anúncio nenhum."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "19f5183b-183b-41f8-a257-4f920b433e40"
      },
      "router": {}
    },
    "owner": "rodrigosilverio",
    "runtimeVersion": "1.2.0"
  }
}
